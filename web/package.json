{
  "name": "avtalsagent-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Webbappen för Avtalsanalys-Agent: chatt med agentens tankar och steg, svar med källor och källpanel.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "mock": "node mock/server.ts",
    "build": "next build",
    "start": "cp -R .next/static .next/standalone/.next/ && node .next/standalone/server.js",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"mock/**/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.1",
    "@copilotkit/react-core": "1.77.0",
    "@copilotkit/runtime": "1.77.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-pdf": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ag-ui/core": "1.0.1",
    "@ag-ui/encoder": "1.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
