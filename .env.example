# Copy to .env and fill in what you need: cp .env.example .env
# .env is in .gitignore and must never be committed.
# Empty values count as "not set", so the defaults in src/avtalsagent/config.py
# and docker-compose.yml apply.

# OpenAI key (needed from M4). Never commit, print or log it.
OPENAI_API_KEY=

# Database used by the code. Default: postgresql://avtalsagent:avtalsagent@localhost:5432/avtalsagent
DATABASE_URL=

# Postgres container in docker-compose.yml. Default for all three: avtalsagent
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Port on your machine. Default: 5432
POSTGRES_PORT=

# Which model plays which role (ADR 0005). Defaults: gpt-6.1-sol, gpt-6-astra, gpt-6-luna
AGENT_MODEL=
REVIEWER_MODEL=
EXTRACTION_MODEL=

# Default: INFO
LOG_LEVEL=
