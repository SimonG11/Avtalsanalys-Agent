# Copy to .env and fill in what you need: cp .env.example .env
# .env is in .gitignore and must never be committed.
# Empty values count as "not set", so the defaults in src/avtalsagent/config.py
# and docker-compose.yml apply.

# OpenAI key (needed from M4; index, run and search need it from M5). Never commit, print or log it.
OPENAI_API_KEY=

# Database used by the code. Default: postgresql+psycopg://avtalsagent:avtalsagent@localhost:5432/avtalsagent
DATABASE_URL=

# Postgres container in docker-compose.yml. Default for all three: avtalsagent
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Port on your machine. Default: 5432
POSTGRES_PORT=

# Which model plays which role (ADR 0005). Defaults: gpt-6.1-sol, gpt-6-astra, gpt-6-luna
AGENT_MODEL=
REVIEWER_MODEL=
EXTRACTION_MODEL=

# Default: INFO
LOG_LEVEL=

# Where the Excel master list is downloaded from (M1). Default: https://www.avropa.se/giltigaramavtal/excel
REGISTER_EXCEL_URL=
# Folder for downloaded files. Default: data
DATA_DIR=

# Fetching agreement documents from avropa.se (M2). Lists are JSON, e.g. ["IT-drift"].
# Default index: https://www.avropa.se/ramavtal/ramavtal-a-o/
AGREEMENT_INDEX_URL=
# Default: ["IT-drift", "Bemanningstjänster", "IT-konsulttjänster Resurskonsulter", "Programvaror och tjänster"]
FETCH_AREAS=
# Default: ["pdf", "docx"]
FETCH_FILE_TYPES=
# Seconds between requests. Default: 0.5
FETCH_DELAY_SECONDS=

# Deviations a person has accepted, so they no longer quarantine (M4). Default: accepted_findings.toml
ACCEPTED_FINDINGS_FILE=

# The search (M5, ADR 0011). Defaults: text-embedding-3-large, 1536, 100
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=
# Chunks per branch, the k of reciprocal rank fusion and sections per search. Defaults: 100, 60, 8
SEARCH_CANDIDATES=
RRF_K=
SEARCH_LIMIT=

# The tool layer avtal-mcp (M6, ADR 0012). Lists are JSON.
# Defaults: http://localhost:8001/mcp, 8001, ["localhost:*", "127.0.0.1:*", "mcp:8001"]
MCP_URL=
MCP_PORT=
MCP_ALLOWED_HOSTS=

# The agent (M7, ADR 0013): how much the model reasons (low, medium, high or xhigh), model calls
# per run, and new attempts after a failed citation check. Defaults: low, 16, 1
AGENT_REASONING_EFFORT=
AGENT_MODEL_CALL_LIMIT=
CITATION_RETRIES=
# How the agent reaches avtal-mcp: stdio (starts it as a child process with the same environment)
# or streamable_http (connects to MCP_URL). Default: stdio
MCP_TRANSPORT=
# Where the agent keeps its checkpoints: memory (lost on exit) or postgres (DATABASE_URL).
# Default: memory
CHECKPOINTER=
